# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Channel ID where commands are posted and watched
# (right-click channel → Copy Channel ID, enable Developer Mode first)
COMMAND_CHANNEL_ID=123456789012345678

# Optional: only allow these Discord user IDs to send commands
# Leave empty to allow everyone in the channel (not recommended)
ALLOWED_USER_IDS=

# Password the daemon will ask for before executing a command
APPROVAL_PASSWORD=change_me_strong_password

# Prefix for commands
COMMAND_PREFIX=!
